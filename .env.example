PORT=3000
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=ganti-dengan-secret-jwt-yang-kuat
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-admin-yang-kuat
IMAGEKIT_PRIVATE_KEY=private-key-imagekit
IMAGEKIT_FOLDER=/falstore/products
# Server only. Obtain a customer API key from https://portal.axiomcreative.xyz/dashboard/kunci-api
AXIOM_API_KEY=
# Optional smoke upload uses real ImageKit storage; disabled by default.
SMOKE_IMAGEKIT_UPLOAD=0
# Configure a scheduler every minute: GET /api/payments/reconcile
# Header: Authorization: Bearer <CRON_SECRET>. Keep this secret server-side.
CRON_SECRET=
